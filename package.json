{
  "name": "bimail",
  "private": true,
  "version": "1.0.0-mvp",
  "type": "module",
  "description": "BiMail — 一堵只有两个人的墙",
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:web": "vite",
    "dev:api": "node server/dev-server.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:sql": "node tests/sql/run.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check": "npm run typecheck && npm run check:copy && npm run check:contrast && npm run test && npm run test:integration && npm run test:sql && npm run build && npm run check:budget"
  },
  "dependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0",
    "vue-tsc": "^3.0.0"
  }
}
