# Backend selection: local (zero-service dev backend) | supabase (production)
VITE_BACKEND=local

# Only needed when VITE_BACKEND=supabase
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Anonymous sign-in must be enabled in Supabase Auth settings.
# SQL migrations live in supabase/migrations/ (see README).
